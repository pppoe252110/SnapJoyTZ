  m_Script: {fileID: 11500000, guid: 75279ef1e3ae0e24e8fc02425c7fcc18, type: 3}
  m_Name: QuestStartDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  Nodes:
  - ID: start
    SpeakerName: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    Text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043F\u0443\u0442\u043D\u0438\u043A.
      \u0427\u0442\u043E \u043F\u0440\u0438\u0432\u0435\u043B\u043E \u0442\u0435\u0431\u044F
      \u0441\u044E\u0434\u0430?"
    Options:
    - Text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
        \u043C\u0438\u043C\u043E"
      NextNodeID: node_bye
      Condition:
        Type: 1
        TargetID: find_random_item
        Invert: 1
      OnSelectAction:
        Type: 0
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    - Text: "\u0418\u0449\u0443 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439.
        \u041D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C?"
      NextNodeID: node_quest_offer
      Condition:
        Type: 1
        TargetID: find_random_item
        Invert: 1
      OnSelectAction:
        Type: 0
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    - Text: "\u042F \u0435\u0449\u0451 \u0438\u0449\u0443 \u043F\u0440\u0435\u0434\u043C\u0435\u0442"
      NextNodeID: node_bye
      Condition:
        Type: 1
        TargetID: find_random_item
        Invert: 0
      OnSelectAction:
        Type: 0
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    OnEnterAction:
      Type: 0
      TargetID: 
      Quest: {fileID: 0}
      Parameter: 
  - ID: node_bye
    SpeakerName: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    Text: "\u041D\u0443, \u0443\u0434\u0430\u0447\u0438 \u0442\u043E\u0433\u0434\u0430"
    Options:
    - Text: "\u041F\u043E\u043A\u0430!"
      NextNodeID: 
      Condition:
        Type: 0
        TargetID: 
        Invert: 0
      OnSelectAction:
        Type: 4
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    OnEnterAction:
      Type: 0
      TargetID: 
      Quest: {fileID: 0}
      Parameter: 
  - ID: node_quest_offer
    SpeakerName: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    Text: "\u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u0434\u0430. \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C
      \u043C\u043D\u0435 \u0441\u0442\u0430\u0440\u0443\u044E \u043A\u043D\u0438\u0433\u0443
      \u0438\u0437 \u0441\u0443\u043D\u0434\u0443\u043A\u0430?\n"
    Options:
    - Text: "\u041B\u0430\u0434\u043D\u043E, \u043F\u0440\u0438\u043D\u0435\u0441\u0443."
      NextNodeID: node_accept
      Condition:
        Type: 0
        TargetID: 
        Invert: 0
      OnSelectAction:
        Type: 0
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    - Text: "\u041D\u0435\u0442, \u044F \u043D\u0435 \u043A\u0443\u0440\u044C\u0435\u0440"
      NextNodeID: node_refuse
      Condition:
        Type: 0
        TargetID: 
        Invert: 0
      OnSelectAction:
        Type: 0
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    OnEnterAction:
      Type: 0
      TargetID: 
      Quest: {fileID: 0}
      Parameter: 
  - ID: node_accept
    SpeakerName: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    Text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E! \u0416\u0434\u0443 \u0442\u0435\u0431\u044F
      \u0437\u0434\u0435\u0441\u044C."
    Options:
    - Text: "\u0421\u043A\u043E\u0440\u043E \u0431\u0443\u0434\u0443!"
      NextNodeID: 
      Condition:
        Type: 0
        TargetID: 
        Invert: 0
      OnSelectAction:
        Type: 4
        TargetID: 
        Quest: {fileID: 0}
        Parameter: 
    OnEnterAction:
      Type: 1
      TargetID: 
      Quest: {fileID: 11400000, guid: 3fc104b2e82d15346b5025091e62eb37, type: 2}
      Parameter: 
  - ID: node_refuse
    SpeakerName: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    Text: "\u0416\u0430\u043B\u044C. \u041C\u043E\u0436\u0435\u0442, \u0432 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0440\u0430\u0437"
    Options:
    - Text: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C. \u0414\u043E
        \u0432\u0441\u0442\u0440\u0435\u0447\u0438"
