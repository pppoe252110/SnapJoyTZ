{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3960f3fca48d48189c6c1a775317ab06",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Grid (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -485.0000305175781,
            "y": 299.0000305175781,
            "width": 218.00003051757813,
            "height": 213.99996948242188
        }
    },
    "m_Slots": [
        {
            "m_Id": "95b123f935a44b5faa74051d5c34a700"
        },
        {
            "m_Id": "ca1c4980dc094dfa93cd5c5ae515b589"
        },
        {
            "m_Id": "dca45bc00faf4582bdb7266b08b86482"
        },
        {
            "m_Id": "b7a608ccc3604023bdc4cc5edf683544"
        },
        {
            "m_Id": "fb16dd211bad47229caa6680df317c98"
        },
        {
            "m_Id": "c569f1eb267040deaba701a3573daa63"
        },
        {
            "m_Id": "99d2484018914f06b7986ae94d024aa8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Grid",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "    float3 blend = abs(WorldNormal);\r\n    blend /= (blend.x + blend.y + blend.z);\r\n\r\n    float2 uvX = WorldPos.zy * Scale;\r\n    float2 uvY = WorldPos.xz * Scale;\r\n    float2 uvZ = WorldPos.xy * Scale;\r\n\r\n    // Helper lambda equivalent inlined\r\n    // For each plane: grid = min( saturate((1 - abs(frac(uv-0.5)-0.5)/LineWidth) / fwidth(uv)) )\r\n    float2 gx = abs(frac(uvX - 0.5) - 0.5) / LineWidth;\r\n    float2 gy = abs(frac(uvY - 0.5) - 0.5) / LineWidth;\r\n    float2 gz = abs(frac(uvZ - 0.5) - 0.5) / LineWidth;\r\n\r\n    float gridX = min(saturate((1.0 - gx.x) / max(fwidth(uvX.x), 0.0001)),\r\n                      saturate((1.0 - gx.y) / max(fwidth(uvX.y), 0.0001)));\r\n    float gridY = min(saturate((1.0 - gy.x) / max(fwidth(uvY.x), 0.0001)),\r\n                      saturate((1.0 - gy.y) / max(fwidth(uvY.y), 0.0001)));\r\n    float gridZ = min(saturate((1.0 - gz.x) / max(fwidth(uvZ.x), 0.0001)),\r\n                      saturate((1.0 - gz.y) / max(fwidth(uvZ.y), 0.0001)));\r\n\r\n    float combinedGrid = gridX * blend.x + gridY * blend.y + gridZ * blend.z;\r\n    OutColor = lerp(BaseColor, GridColor, combinedGrid);"
}

